<%
var banner_img_height = parseFloat(page.banner_img_height || theme.index.banner_img_height)
%>

<div class="header-inner" style="height: <%= banner_img_height %>vh;">
  <%- partial('_partials/header/navigation') %>
  <%- partial('_partials/header/banner') %>
</div>

<!-- 登录/注册按钮 -->
<div id="netlify-login-container">
  <button 
    class="netlify-identity-button"
    data-netlify-identity-button
  >
    登录 / 注册
  </button>
</div>

<!-- 用户信息显示（登录后） -->
<div id="user-info" style="display: none;">
  <span id="user-email"></span>
  <button onclick="logout()">退出登录</button>
</div>

<script>
  // 监听登录状态
  if (window.netlifyIdentity) {
    window.netlifyIdentity.on("login", function(user) {
      document.getElementById('netlify-login-container').style.display = 'none';
      document.getElementById('user-info').style.display = 'block';
      document.getElementById('user-email').textContent = user.email;
      console.log("用户已登录:", user.email);
    });

    window.netlifyIdentity.on("logout", function() {
      document.getElementById('netlify-login-container').style.display = 'block';
      document.getElementById('user-info').style.display = 'none';
      console.log("用户已退出");
    });
  }

  // 退出登录函数
  function logout() {
    if (window.netlifyIdentity) {
      window.netlifyIdentity.logout();
    }
  }
</script>
